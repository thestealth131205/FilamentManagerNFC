<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NFC: rohe NfcA-Commands gegen ACE-2-Pro-kompatible Tags (PLAN.md "Tag-Hardware & Format") -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Kamera: Etikett-Scan (Barcode + On-Device-OCR, PLAN.md Schritt 5) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".FilamentManagerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FilamentManagerNFC"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FilamentManagerNFC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
