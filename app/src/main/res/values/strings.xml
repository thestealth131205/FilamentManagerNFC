    <string name="onboarding_title">Permissions</string>
    <string name="onboarding_intro">To work properly, Filament Manager NFC needs access to the camera and NFC. Here is what for:</string>
    <string name="onboarding_camera_title">Camera</string>
    <string name="onboarding_camera_desc">Used to photograph the label on a filament spool and automatically suggest material, color and temperatures.</string>
    <string name="onboarding_nfc_title">NFC</string>
    <string name="onboarding_nfc_desc">Used to write a spool\'s data to an NFC tag (compatible with the Anycubic ACE 2 Pro) or read it from a tag. This permission is granted automatically at install time, no further prompt needed.</string>
    <string name="onboarding_nfc_desc_missing">This device does not appear to have NFC – reading/writing tags is not possible, but the other features (database, label scan) still work.</string>
    <string name="onboarding_continue">Grant permissions and continue</string>
